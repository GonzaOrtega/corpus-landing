# Secrets — never commit real values. .env.example is the only tracked env file.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
.secrets/
credentials*.json
gitleaks-report.*
# Registry and MCP configs routinely carry inline tokens.
.npmrc
.mcp.json
.claude/settings.local.json
/ops/launch-review/

# Platform / tooling caches
.vercel
.turbo
.drizzle/
.worktrees/
*.tsbuildinfo
.claude/scheduled_tasks.lock
# Per-machine subagent memory: written by local agent runs, not shared state.
.claude/agent-memory-local/
# Local SDD task briefs, reports and review diffs.
.superpowers/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json


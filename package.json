{
  "name": "corpus-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Public early-access landing page for Corpus, an Android-first language-learning product.",
  "license": "MIT",
  "author": "Gonzalo Ortega",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GonzaOrtega/corpus-landing.git"
  },
  "homepage": "https://github.com/GonzaOrtega/corpus-landing#readme",
  "bugs": "https://github.com/GonzaOrtega/corpus-landing/issues",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "sh -c 'trap \"docker compose down\" EXIT; docker compose run --rm e2e'",
    "test:all": "bun run check && bun run test && bun run test:e2e",
    "lighthouse": "lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ops:launch-dry-run": "bun scripts/launch-email.ts dry-run",
    "ops:launch-production": "bun scripts/launch-email.ts production",
    "stack:check": "bun scripts/stack-conformance/stack-audit.ts . --ci",
    "check": "bun run typecheck && bun run lint && bun run stack:check",
    "deps:adopt": "bash scripts/adopt-deps.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@react-email/components": "^1.0.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.12",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "npm:@typescript/typescript6",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": "24.x"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}

+  - "src/features/early-access/actions/**"
+  - "src/features/early-access/early-access.wiring.ts"
+  - "src/features/legal/content.ts"
+  - "app/**"
+  - "instrumentation.ts"
+  - "instrumentation-client.ts"
+  - "sentry.server.config.ts"
+  - "sentry.edge.config.ts"
+  - "next.config.ts"
+  - "proxy.ts"
+  - "playwright.config.ts"
+  - "compose.yaml"
+  - "package.json"
+  - "bun.lock"
+  - ".env.example"
+  - "README.md"
+  - "tests/unit/**"
+  - "docs/operations/sentry.md"
+  - "docs/superpowers/specs/2026-09-19-sentry-observability-design.md"
+round_cap: 2
+severity_floor: important    # findings below this become "later"
+reviewers:
+  - "pr-review-toolkit:code-reviewer"
+  - "pr-review-toolkit:silent-failure-hunter"
+  - "pr-review-toolkit:pr-test-analyzer"
+  - "security"
+done:                        # evidence the ledger must carry on a fresh SHA before merge
+  - id: "check"
+    how: "bun run check  (typecheck + biome lint + stack conformance audit)"
+  - id: "unit"
+    how: "bun run test  (Vitest; includes sentry-options.test.ts scrubber assertions against the never-log values)"
+  - id: "e2e"
+    how: "bun run test:e2e  (containerized Playwright via docker compose; asserts the pipeline no-report signal)"
+  - id: "lighthouse"
+    how: "bun run lighthouse  (LHCI; landing page mobile performance >= 0.90, median of three runs, per spec 31 and observability decision 7)"
+mirror: pr-comment           # pr-comment | none
+threat_model: docs/quality/reviews/threat-model.md

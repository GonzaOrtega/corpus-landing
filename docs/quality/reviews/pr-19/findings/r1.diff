+    E2E_NEON_HTTP_ENDPOINT: undefined,
+  };
+
+  it.each([
+    ['CI', { CI: 'true' }],
+    ['NODE_ENV=test', { NODE_ENV: 'test' }],
+    ['E2E_NEON_HTTP_ENDPOINT', { E2E_NEON_HTTP_ENDPOINT: 'http://proxy:4444/sql' }],

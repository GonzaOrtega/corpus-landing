+  - id: "unit-tests"
+    how: "bun run test"
+  - id: "ui-e2e"
+    how: "bun run test:e2e; this is the repository's UI gate because no ui:p0 or ui:affected script exists"
+  - id: "github-required-checks"
+    how: "Confirm check, test, preview, e2e, and lighthouse are successful on GitHub PR #17"
+  - id: "waf-observation-rule"
+    how: "npx --yes vercel@latest firewall rules inspect early-access-server-actions; confirm production host, POST paths, IP fixed-window 10 per 60 seconds, and log-only follow-up"
+mirror: pr-comment           # pr-comment | none
+threat_model: docs/quality/reviews/threat-model.md

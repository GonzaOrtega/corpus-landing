++    ]);
++    expect((await repository.findLaunchEligible(10, row.id)).map((r) => r.id)).toEqual([row.id]);
++    expect((await repository.findPiiPurgeDue(new Date(), 10)).map((r) => r.id)).toEqual([row.id]);

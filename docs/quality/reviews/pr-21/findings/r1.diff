+const harness = vi.hoisted(() => ({
+  repository: null as InMemoryEarlyAccessSignupRepository | null,
+}));
+
+vi.mock('../../composition/capabilities/persistence', () => ({
+  providePersistence: () => ({ earlyAccessSignupRepository: harness.repository }),
+}));

+    const { resolve, unsubscribe } = getManagementUseCases();
+
+    expect(resolve).toBeInstanceOf(ResolveEarlyAccessManagementUseCase);
+    expect(unsubscribe).toBeInstanceOf(UnsubscribeEarlyAccessUseCase);

# Names only — real values live in Vercel/Neon environment settings, never in
# git, at any point in history. See docs/superpowers/specs §35 and §40.

# --- Site ---------------------------------------------------------------
# Canonical origin for the current environment.
SITE_URL=

# --- Product lifecycle (§3) ----------------------------------------------
# early-access | launched
CORPUS_RELEASE_STAGE=
# Required only when CORPUS_RELEASE_STAGE=launched.
CORPUS_DOWNLOAD_URL=

# --- Database (Neon / Drizzle) -------------------------------------------
# Supply approved non-production Neon connections through local secret storage.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URL_TEST=

# --- CAPTCHA (§8) ---------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional; validated server configuration applies the documented default.
RECAPTCHA_SCORE_THRESHOLD=

# --- Email (Resend, §5) ---------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
REPLY_TO=
EMAIL_POSTAL_ADDRESS=

# --- Cron / maintenance (§10, §12) ----------------------------------------
CRON_SECRET=

# --- Launch send safety valve (§12.1) -------------------------------------
# Required for the dry run; the production send targets real subscribers.
LAUNCH_DRY_RUN_RECIPIENT=
# Required only by the launch-send operation. Use a distinct 32+ byte secret
# per environment; it derives stable retry-safe management tokens and never
# leaves the server or the database as raw text.
MANAGEMENT_TOKEN_SECRET=

# --- Automation-only (not read by the app at runtime) ---------------------
# CI/CD and deploy automation may additionally require Vercel and Neon
# project IDs/tokens. Those are GitHub Actions repository secrets, not
# entries here — see docs/operations/branch-protection.md and Task 19/20.

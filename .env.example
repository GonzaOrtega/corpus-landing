# Names only — real values live in Vercel/Neon environment settings, never in
# git, at any point in history. See docs/superpowers/specs §35 and §40.

# --- Site ---------------------------------------------------------------
# Local dev port is pinned once this project is registered in
# /home/gonza/github/.ports.json (pending) — see docs/execution/stages.md.
SITE_URL=http://localhost:3000

# --- Product lifecycle (§3) ----------------------------------------------
# early-access | launched
CORPUS_RELEASE_STAGE=early-access
# Required only when CORPUS_RELEASE_STAGE=launched.
CORPUS_DOWNLOAD_URL=

# --- Database (Neon / Drizzle) -------------------------------------------
DATABASE_URL=postgres://user:password@host/db
DATABASE_URL_UNPOOLED=postgres://user:password@host/db
DATABASE_URL_TEST=postgres://user:password@host/db_test

# --- CAPTCHA (§8) ---------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5

# --- Email (Resend, §5) ---------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
REPLY_TO=
EMAIL_POSTAL_ADDRESS=

# --- Cron / maintenance (§10, §12) ----------------------------------------
CRON_SECRET=

# --- Launch send safety valve (§12.1) -------------------------------------
# Required for the dry run; the production send targets real subscribers.
LAUNCH_DRY_RUN_RECIPIENT=

# --- Automation-only (not read by the app at runtime) ---------------------
# CI/CD and deploy automation may additionally require Vercel and Neon
# project IDs/tokens. Those are GitHub Actions repository secrets, not
# entries here — see docs/operations/branch-protection.md and Task 19/20.

# Names only — real values live in Vercel/Neon environment settings, never in
# git, at any point in history. See docs/superpowers/specs §35 and §40.

# --- Site ---------------------------------------------------------------
# Canonical origin for the current environment.
SITE_URL=

# --- Product lifecycle (§3) ----------------------------------------------
# early-access | launched
CORPUS_RELEASE_STAGE=
# Required only when CORPUS_RELEASE_STAGE=launched.
CORPUS_DOWNLOAD_URL=

# --- Database (Neon / Drizzle) -------------------------------------------
# Supply approved non-production Neon connections through local secret storage.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# DESTRUCTIVE, and not interchangeable with the two above. The repository
# integration suite DELETES EVERY ROW of the signup table before each of its
# tests, and this is the only variable that switches that suite on. Bun loads
# this file's real counterpart into every `bun run`, `check` included, so
# whatever you put here is in scope for that delete.
#
# Point it only at a throwaway database you can lose — never the shared Neon
# `development` branch that DATABASE_URL uses. Leave it blank to skip the
# suite entirely; the CI `test` job supplies its own disposable branch.
# Recipe: docs/quality/testing.md, "Measuring the Drizzle repository".
DATABASE_URL_TEST=

# --- CAPTCHA (§8) ---------------------------------------------------------
# Public Google Cloud Fraud Defense site key (Key ID).
RECAPTCHA_SITE_KEY=
# Server-only API key. Restrict it to the reCAPTCHA Enterprise API in Google Cloud.
RECAPTCHA_API_KEY=
# Google Cloud project ID that owns the reCAPTCHA site key and API key.
RECAPTCHA_PROJECT_ID=
# Optional; validated server configuration applies the documented default.
RECAPTCHA_SCORE_THRESHOLD=
# Set to 1 to use the deterministic non-network verifier. Required only where
# VERCEL_ENV is absent — local, container and CI runs — because selecting the
# fake from that absence alone would leave any non-Vercel host with a
# CAPTCHA-free signup form. Vercel Preview and Development need it not at all,
# and Production refuses to start if it is set.
CORPUS_FAKE_CAPTCHA=

# --- Email (Resend, §5) ---------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
REPLY_TO=
EMAIL_POSTAL_ADDRESS=

# --- Cron / maintenance (§10, §12) ----------------------------------------
CRON_SECRET=

# --- Launch send safety valve (§12.1) -------------------------------------
# Required for the dry run; the production send targets real subscribers.
LAUNCH_DRY_RUN_RECIPIENT=
# Required only by the launch-send operation. Use a distinct 32+ byte secret
# per environment; it derives stable retry-safe management tokens and never
# leaves the server or the database as raw text.
MANAGEMENT_TOKEN_SECRET=

# --- Error reporting, tracing and logs (Sentry) ---------------------------
# See docs/operations/sentry.md and the 2026-09-19 observability spec.
# Public DSN, inlined into the browser bundle at build time. Unset or blank
# disables the SDK everywhere; CI, Vitest and the E2E container never report
# even when it is set.
NEXT_PUBLIC_SENTRY_DSN=
# Optional 0..1 override for server-side tracing (Server Actions, RSC, cron,
# outgoing calls). Defaults: 0.1 in Production, 1 elsewhere.
SENTRY_TRACES_SAMPLE_RATE=
# Browser page-load/navigation tracing is OFF unless this is set (0..1). It is
# the one piece measured to cost Lighthouse performance points; see
# docs/operations/sentry.md before enabling it.
NEXT_PUBLIC_SENTRY_BROWSER_TRACES_SAMPLE_RATE=
# Source-map upload target (build time only, not secret).
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only, never read by the app. Lives in GitHub Actions secrets for
# the workflows that run `vercel build`; a Vercel "Sensitive" variable pulls as
# [SENSITIVE] and is treated as unset. Without it the build only skips upload.
SENTRY_AUTH_TOKEN=

# --- Automation-only (not read by the app at runtime) ---------------------
# CI/CD and deploy automation may additionally require Vercel and Neon
# project IDs/tokens. Those are GitHub Actions repository secrets, not
# entries here — see docs/operations/branch-protection.md and Task 19/20.
